<%= form_with model: @restaurant do |f| %>
  <div class="mb-3">
    <%= f.label :name %>
    <%= f.text_field :name %>
  </div>
  <div class="mb-3">
    <%= f.label :address %>
    <%= f.text_field :address %>
  </div>
    <div class="mb-3">
    <%= f.label :category %>
    <%= f.text_field :category %>
  </div>
  <div class="mb-3">
    <%= f.label :phone_number %>
    <%= f.text_field :phone_number %>
  </div>
  <div class="mb-3">
    <%= f.submit %>
<% end %>
